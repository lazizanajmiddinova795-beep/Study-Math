# Copy this file to .env.local and fill in values. NEVER commit .env.local.
#   macOS/Linux:  cp .env.example .env.local
#   Windows:      Copy-Item .env.example .env.local
# All values below are PLACEHOLDERS. The app detects untouched placeholders and
# reports the configuration as invalid instead of pretending it is connected.
# After editing .env.local, restart `npm run dev`.

# --- Public (safe for browsers; protected by Row Level Security) ---
# Supabase dashboard -> Project Settings -> API (or the "Connect" dialog).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Use ONE of the two names below. Prefer the publishable key ("sb_publishable_...").
# The legacy "anon" JWT key also works. NEVER put a secret / service_role key here:
# the app refuses to start auth if it detects one in a public variable.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public URL of this app. Used for the email-confirmation link (must also be listed
# under Supabase -> Authentication -> URL Configuration -> Redirect URLs).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Branding (all optional) ---
NEXT_PUBLIC_BRAND_NAME=Math Learning Platform
NEXT_PUBLIC_BRAND_TAGLINE=Understand mathematics, step by step.

# --- Server-only secrets (NEVER prefix with NEXT_PUBLIC_) ---
# Needed only for admin operations (creating users, approving students).
# Supabase -> Project Settings -> API -> service_role / secret key.
# Never paste it into chat, source files, screenshots or client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI provider (optional). The app runs without these; AI features report "not configured".
# Supported values for AI_PROVIDER: gemini (adapter not implemented yet)
AI_PROVIDER=
AI_API_KEY=
